<section
  id="ProductShowcase-{{ section.id }}"
  class="twcss-w-full twcss-bg-white"
>

  {% assign current_variant = product.selected_or_first_available_variant %}

  <div class="twcss-mx-auto twcss-max-w-[1440px] twcss-px-5 md:twcss-px-10">

    <div class="
      twcss-grid
      twcss-grid-cols-1
      lg:twcss-grid-cols-[1.2fr_0.8fr]
      twcss-gap-10
      lg:twcss-gap-20
    ">

      <!-- ================================================= -->
      <!-- LEFT : PRODUCT IMAGE / SLIDER -->
      <!-- ================================================= -->

      <div class="twcss-relative">

        <div
          id="ProductGallery-{{ section.id }}"
          class="
            twcss-relative
            twcss-h-[500px]
            sm:twcss-h-[600px]
            lg:twcss-h-[680px]
            twcss-overflow-hidden
          "
        >

          <!-- ============================================ -->
          <!-- PRODUCT IMAGES -->
          <!-- ============================================ -->

          {% for image in product.images limit: 4 %}

            <div
              class="
                product-showcase-slide
                twcss-absolute
                twcss-inset-0
                twcss-flex
                twcss-items-center
                twcss-justify-center
                {% if forloop.first %}
                  twcss-opacity-100
                {% else %}
                  twcss-opacity-0
                  twcss-pointer-events-none
                {% endif %}
              "
              data-slide="{{ forloop.index0 }}"
            >

              <img
                src="{{ image | image_url: width: 1200 }}"
                alt="{{ image.alt | default: product.title | escape }}"
                class="
                  twcss-block
                  twcss-h-auto
                  twcss-max-h-full
                  twcss-w-auto
                  twcss-max-w-full
                  twcss-object-contain
                "
                width="{{ image.width }}"
                height="{{ image.height }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              >

            </div>

          {% endfor %}


          <!-- ============================================ -->
          <!-- VARIANT IMAGE - LAST / STAR POSITION -->
          <!-- ============================================ -->

          <div
            id="VariantImageContainer-{{ section.id }}"
            class="
              twcss-absolute
              twcss-bottom-[5%]
              twcss-left-[5%]
              twcss-z-20
              twcss-w-[22%]
            "
          >

            {% if current_variant.featured_image %}

              <img
                id="VariantImage-{{ section.id }}"
                src="{{ current_variant.featured_image | image_url: width: 500 }}"
                alt="{{ current_variant.title | escape }}"
                class="
                  twcss-block
                  twcss-h-auto
                  twcss-w-full
                  twcss-object-contain
                "
                width="{{ current_variant.featured_image.width }}"
                height="{{ current_variant.featured_image.height }}"
              >

            {% elsif product.featured_image %}

              <img
                id="VariantImage-{{ section.id }}"
                src="{{ product.featured_image | image_url: width: 500 }}"
                alt="{{ product.title | escape }}"
                class="
                  twcss-block
                  twcss-h-auto
                  twcss-w-full
                  twcss-object-contain
                "
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
              >

            {% endif %}

          </div>

        </div>


        <!-- ================================================= -->
        <!-- SLIDER NAVIGATION -->
        <!-- ================================================= -->

        <div class="
          twcss-mt-5
          twcss-flex
          twcss-items-center
          twcss-justify-center
          twcss-gap-4
        ">

          <!-- PREVIOUS -->

          <button
            type="button"
            class="
              product-showcase-prev
              twcss-flex
              twcss-h-8
              twcss-w-8
              twcss-items-center
              twcss-justify-center
              twcss-text-xl
              hover:twcss-opacity-60
            "
            aria-label="Previous image"
          >
            ‹
          </button>


          <!-- PAGINATION -->

          <div
            class="
              product-showcase-pagination
              twcss-flex
              twcss-items-center
              twcss-gap-4
            "
          >

            {% for image in product.images limit: 4 %}

              <button
                type="button"
                data-slide-button="{{ forloop.index0 }}"
                class="
                  product-showcase-pagination-button
                  twcss-flex
                  twcss-h-5
                  twcss-w-5
                  twcss-items-center
                  twcss-justify-center
                  twcss-text-xs
                  {% if forloop.first %}
                    twcss-bg-black
                    twcss-text-white
                  {% else %}
                    twcss-bg-transparent
                    twcss-text-black
                  {% endif %}
                "
              >
                {{ forloop.index }}
              </button>

            {% endfor %}

          </div>


          <!-- NEXT -->

          <button
            type="button"
            class="
              product-showcase-next
              twcss-flex
              twcss-h-8
              twcss-w-8
              twcss-items-center
              twcss-justify-center
              twcss-text-xl
              hover:twcss-opacity-60
            "
            aria-label="Next image"
          >
            ›
          </button>

        </div>

      </div>


      <!-- ================================================= -->
      <!-- RIGHT : PRODUCT INFORMATION -->
      <!-- ================================================= -->

      <div class="
        twcss-flex
        twcss-flex-col
        twcss-justify-center
      ">

        <!-- PRODUCT TITLE -->

        <h1
          class="
            twcss-m-0
            twcss-max-w-[550px]
            twcss-text-[42px]
            md:twcss-text-[52px]
            lg:twcss-text-[60px]
            twcss-font-medium
            twcss-uppercase
            twcss-leading-[0.95]
          "
        >
          {{ product.title }}
        </h1>


        <!-- PRODUCT DESCRIPTION -->

        {% if product.description != blank %}

          <div
            class="
              twcss-mt-6
              twcss-max-w-[500px]
              twcss-text-sm
              twcss-leading-[1.35]
            "
          >
            {{ product.description }}
          </div>

        {% endif %}


        <!-- ================================================= -->
        <!-- PRICE -->
        <!-- ================================================= -->

        <div
          id="ProductPrice-{{ section.id }}"
          class="
            twcss-mt-8
            twcss-text-[36px]
            md:twcss-text-[40px]
            twcss-font-medium
          "
        >

          {{ current_variant.price | money }}

        </div>


        <!-- ================================================= -->
        <!-- PRODUCT FORM -->
        <!-- ================================================= -->

        <form
          method="post"
          action="{{ routes.cart_add_url }}"
          id="ProductForm-{{ section.id }}"
          class="twcss-mt-2"
        >

          <input
            type="hidden"
            name="id"
            id="ProductVariantId-{{ section.id }}"
            value="{{ current_variant.id }}"
          >


          <!-- =============================================== -->
          <!-- PRODUCT OPTIONS -->
          <!-- =============================================== -->

          {% for option in product.options_with_values %}

            {% assign option_name = option.name | downcase %}


            <!-- ============================================ -->
            <!-- SIZE -->
            <!-- ============================================ -->

            {% if option_name == 'size' %}

              <div class="twcss-mt-8">

                <label
                  class="
                    twcss-mb-3
                    twcss-block
                    twcss-text-sm
                    twcss-uppercase
                  "
                >
                  {{ option.name }}
                </label>


                <div class="twcss-flex twcss-flex-wrap twcss-gap-2">

                  {% for value in option.values %}

                    <button
                      type="button"
                      class="
                        product-option-button
                        twcss-flex
                        twcss-h-8
                        twcss-min-w-8
                        twcss-items-center
                        twcss-justify-center
                        twcss-border
                        twcss-border-black
                        twcss-px-2
                        twcss-text-xs
                        twcss-uppercase
                        twcss-transition
                        hover:twcss-bg-black
                        hover:twcss-text-white
                      "
                      data-option-index="{{ forloop.parentloop.index0 }}"
                      data-option-value="{{ value | escape }}"
                    >
                      {{ value }}
                    </button>

                  {% endfor %}

                </div>

              </div>

            {% endif %}


            <!-- ============================================ -->
            <!-- COLOR -->
            <!-- ============================================ -->

            {% if option_name == 'color' or option_name == 'colour' %}

              <div class="twcss-mt-7">

                <label
                  class="
                    twcss-mb-3
                    twcss-block
                    twcss-text-sm
                    twcss-uppercase
                  "
                >
                  {{ option.name }}
                </label>


                <div class="twcss-flex twcss-flex-wrap twcss-gap-3">

                  {% for value in option.values %}

                    <button
                      type="button"
                      aria-label="{{ value | escape }}"
                      class="
                        product-option-button
                        twcss-h-8
                        twcss-w-8
                        twcss-border
                        twcss-border-black
                        twcss-bg-[#D8CCB8]
                        twcss-transition
                        hover:twcss-scale-105
                      "
                      data-option-index="{{ forloop.parentloop.index0 }}"
                      data-option-value="{{ value | escape }}"
                    >
                    </button>

                  {% endfor %}

                </div>

              </div>

            {% endif %}

          {% endfor %}


          <!-- ================================================= -->
          <!-- BUY NOW -->
          <!-- ================================================= -->

          <button
            type="submit"
            id="ProductSubmit-{{ section.id }}"
            class="
              twcss-mt-10
              twcss-flex
              twcss-h-12
              twcss-w-full
              twcss-max-w-[230px]
              twcss-items-center
              twcss-justify-center
              twcss-bg-[#151515]
              twcss-px-8
              twcss-text-xs
              twcss-font-medium
              twcss-uppercase
              twcss-text-white
              twcss-transition
              hover:twcss-bg-black
            "
            {% unless current_variant.available %}
              disabled
            {% endunless %}
          >

            {% if current_variant.available %}
              Buy Now
            {% else %}
              Sold Out
            {% endif %}

          </button>

        </form>

      </div>

    </div>

  </div>
</section>


<!-- ===================================================== -->
<!-- VARIANT DATA -->
<!-- ===================================================== -->

<script>
  document.addEventListener('DOMContentLoaded', function () {

    const section = document.querySelector(
      '#ProductShowcase-{{ section.id }}'
    );

    if (!section) return;


    /* ================================================
       PRODUCT VARIANTS
    ================================================= */

    const variants = {{ product.variants | json }};

    const productImage = "{{ product.featured_image | image_url: width: 500 }}";


    /* ================================================
       ELEMENTS
    ================================================= */

    const variantImage = section.querySelector(
      '#VariantImage-{{ section.id }}'
    );

    const variantIdInput = section.querySelector(
      '#ProductVariantId-{{ section.id }}'
    );

    const priceElement = section.querySelector(
      '#ProductPrice-{{ section.id }}'
    );

    const submitButton = section.querySelector(
      '#ProductSubmit-{{ section.id }}'
    );


    /* ================================================
       SELECTED OPTIONS
    ================================================= */

    const selectedOptions = [];


    {% for option in product.options_with_values %}

      selectedOptions[{{ forloop.index0 }}] =
        {{ current_variant.options[forloop.index0] | json }};

    {% endfor %}


    /* ================================================
       FIND VARIANT
    ================================================= */

    function findVariant() {

      return variants.find(function (variant) {

        return variant.options.every(function (option, index) {

          return option === selectedOptions[index];

        });

      });

    }


    /* ================================================
       MONEY FORMAT
    ================================================= */

    function formatMoney(cents) {

      return new Intl.NumberFormat(
        '{{ localization.language.iso_code }}',
        {
          style: 'currency',
          currency: '{{ cart.currency.iso_code }}'
        }
      ).format(cents / 100);

    }


    /* ================================================
       UPDATE VARIANT
    ================================================= */

    function updateVariant() {

      const variant = findVariant();

      if (!variant) {
        return;
      }


      /* -----------------------------------------------
         Variant ID
      ------------------------------------------------ */

      if (variantIdInput) {

        variantIdInput.value = variant.id;

      }


      /* -----------------------------------------------
         Price
      ------------------------------------------------ */

      if (priceElement) {

        priceElement.textContent = formatMoney(
          variant.price
        );

      }


      /* -----------------------------------------------
         ⭐ VARIANT IMAGE
         
         ONLY the last/star image changes.
         
         If variant has image:
             use variant image
         
         Otherwise:
             use product image
      ------------------------------------------------ */

      if (variantImage) {

        if (variant.featured_image) {

          variantImage.src =
            variant.featured_image.src;

          variantImage.alt =
            variant.title;

        } else {

          variantImage.src =
            productImage;

          variantImage.alt =
            '{{ product.title | escape }}';

        }

      }


      /* -----------------------------------------------
         Availability
      ------------------------------------------------ */

      if (submitButton) {

        if (variant.available) {

          submitButton.disabled = false;
          submitButton.textContent = 'Buy Now';

        } else {

          submitButton.disabled = true;
          submitButton.textContent = 'Sold Out';

        }

      }

    }


    /* ================================================
       OPTION BUTTONS
    ================================================= */

    const optionButtons = section.querySelectorAll(
      '.product-option-button'
    );


    optionButtons.forEach(function (button) {

      button.addEventListener('click', function () {

        const optionIndex =
          Number(button.dataset.optionIndex);

        const optionValue =
          button.dataset.optionValue;


        /* ---------------------------------------------
           Set selected option
        --------------------------------------------- */

        selectedOptions[optionIndex] =
          optionValue;


        /* ---------------------------------------------
           Active button
        --------------------------------------------- */

        section
          .querySelectorAll(
            '[data-option-index="' +
            optionIndex +
            '"]'
          )
          .forEach(function (item) {

            item.classList.remove(
              'twcss-bg-black',
              'twcss-text-white'
            );

          });


        button.classList.add(
          'twcss-bg-black',
          'twcss-text-white'
        );


        /* ---------------------------------------------
           Update variant
        --------------------------------------------- */

        updateVariant();

      });

    });


    /* ================================================
       INITIAL ACTIVE OPTIONS
    ================================================= */

    optionButtons.forEach(function (button) {

      const index =
        Number(button.dataset.optionIndex);

      const value =
        button.dataset.optionValue;


      if (selectedOptions[index] === value) {

        button.classList.add(
          'twcss-bg-black',
          'twcss-text-white'
        );

      }

    });


    /* ================================================
       SLIDER
    ================================================= */

    const slides = section.querySelectorAll(
      '.product-showcase-slide'
    );

    const paginationButtons = section.querySelectorAll(
      '[data-slide-button]'
    );

    const previousButton = section.querySelector(
      '.product-showcase-prev'
    );

    const nextButton = section.querySelector(
      '.product-showcase-next'
    );


    let currentSlide = 0;


    function showSlide(index) {

      if (!slides.length) return;


      if (index < 0) {

        index = slides.length - 1;

      }


      if (index >= slides.length) {

        index = 0;

      }


      currentSlide = index;


      /* ---------------------------------------------
         Slides
      --------------------------------------------- */

      slides.forEach(function (slide, slideIndex) {

        if (slideIndex === currentSlide) {

          slide.classList.remove(
            'twcss-opacity-0',
            'twcss-pointer-events-none'
          );

          slide.classList.add(
            'twcss-opacity-100'
          );

        } else {

          slide.classList.remove(
            'twcss-opacity-100'
          );

          slide.classList.add(
            'twcss-opacity-0',
            'twcss-pointer-events-none'
          );

        }

      });


      /* ---------------------------------------------
         Pagination
      --------------------------------------------- */

      paginationButtons.forEach(function (button, buttonIndex) {

        button.classList.remove(
          'twcss-bg-black',
          'twcss-text-white'
        );

        button.classList.add(
          'twcss-bg-transparent',
          'twcss-text-black'
        );


        if (buttonIndex === currentSlide) {

          button.classList.remove(
            'twcss-bg-transparent',
            'twcss-text-black'
          );

          button.classList.add(
            'twcss-bg-black',
            'twcss-text-white'
          );

        }

      });

    }


    /* ================================================
       PREVIOUS
    ================================================= */

    if (previousButton) {

      previousButton.addEventListener(
        'click',
        function () {

          showSlide(currentSlide - 1);

        }
      );

    }


    /* ================================================
       NEXT
    ================================================= */

    if (nextButton) {

      nextButton.addEventListener(
        'click',
        function () {

          showSlide(currentSlide + 1);

        }
      );

    }


    /* ================================================
       PAGINATION
    ================================================= */

    paginationButtons.forEach(function (button) {

      button.addEventListener(
        'click',
        function () {

          showSlide(
            Number(button.dataset.slideButton)
          );

        }
      );

    });


    /* ================================================
       INITIALIZE
    ================================================= */

    updateVariant();
    showSlide(0);

  });
</script>


{% schema %}
{
  "name": "Product Showcase",
  "settings": [
    {
      "type": "header",
      "content": "Product Showcase"
    }
  ],
  "presets": [
    {
      "name": "Product Showcase"
    }
  ]
}
{% endschema %}